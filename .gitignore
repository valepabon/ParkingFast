# =====================================
# Node.js & Express MVC - Gitignore
# =====================================

# Node modules
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Logs
logs/
*.log
log.txt

# dotenv files
.env
.env.local
.env.*.local

# System files
.DS_Store
Thumbs.db

# Editor & IDE folders
.vscode/
.idea/

# Build output
dist/
build/

# Coverage (test)
coverage/

# Temporary files
tmp/
temp/
*.tmp

# MongoDB Memory Server (IMPORTANT)
# Evita subir archivos .exe de 60MB+
node_modules/.cache/mongodb-memory-server/

# Supertest temp files
*.pid

# EJS cache
*.ejs~

# Windows recycle & metadata
$RECYCLE.BIN/

# =====================================
# Custom project ignores
# =====================================

# Uploads or static user files (si existen)
uploads/
public/uploads/

# Cache
.cache/
