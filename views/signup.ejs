<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Registro | ConectaPark</title>
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body class="signup-body">
  <div class="signup-container">
    <!-- Columna izquierda con imagen -->
    <div class="signup-left">
      <img src="/images/logo.png" alt="ConectaPark Logo" class="logo-signup">
    </div>

    <!-- Columna derecha con formulario -->
    <div class="signup-form">
      <h2>REGISTRO</h2>

      <form id="signup-form" action="/usuarios" method="POST">
        <label for="nombre">Nombre Completo</label>
        <input type="text" id="nombre" name="nombre" placeholder="Nombre y Apellidos" required>

        <label for="correo">Correo</label>
        <input type="email" id="correo" name="correo" placeholder="Correo electrónico" required>

        <label for="conjunto">Conjunto</label>
        <input type="text" id="conjunto" name="conjunto" placeholder="Nombre de Conjunto">

        <label for="direccion">Torre y Apto</label>
        <input type="text" id="direccion" name="direccion" placeholder="Detalles de vivienda">

        <label for="password">Contraseña</label>
        <input type="password" id="password" name="password" placeholder="Contraseña" required>

        <label for="confirmar">Repetir Contraseña</label>
        <input type="password" id="confirmar" name="confirmar" placeholder="Contraseña" required>

        <button type="submit" class="btn-signup">
          Registrarse
        </button>

        <div class="login-link">
          <p>¿Ya tienes una cuenta?
            <a href="/login" class="btn-login-small">Iniciar sesión</a>
          </p>
        </div>
      </form>
    </div>
  </div>
</body>
</html>

